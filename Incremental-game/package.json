{
  "name": "my-angular-app",
  "version": "0.0.0",
  "main": "main.js",
  "build": {
    "appId": "org.iescamp.din.my-angular-app",
    "productName": "Mi Aplicación Angular",
    "files": [
      "dist/my-angular-app/**/*",
      "main.js",
      "package.json"
    ]
  },
  "win": {
    "target": [
      "nsis"
    ]
  },
  "linux": {
    "target": [
      "AppImage"
    ]
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "dev": "npm-run-all --parallel electron start",
    "electron": "wait-on tcp:4200 && ng build --base-href ./ && electron .",
    "package": "ng build && electron-builder",
    "package-win": "ng build && electron-builder --win",
    "package-linux": "ng build && electron-builder --linux"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@angular/router": "^21.0.0",
    "json-server": "^1.0.0-beta.3",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.0.2",
    "@angular/cli": "^21.0.2",
    "@angular/compiler-cli": "^21.0.0",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "jsdom": "^27.1.0",
    "npm-run-all": "^4.1.5",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8",
    "wait-on": "^9.0.3"
  },
  "description": "This project was generated using [Angular CLI](https://github.com/angular/angular-cli) version 21.0.2.",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs"
}
